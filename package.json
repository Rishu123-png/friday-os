{
  "name": "friday-os",
  "version": "1.0.0",
  "type": "module",
  "description": "FRIDAY OS — personal AI assistant. Offline-first, optional Groq key, offline LLM via llama.cpp.",
  "private": true,
  "scripts": {
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "test": "npm run test:web && npm run test:backend",
    "sync": "npx cap sync android",
    "apk": "cd android && ./gradlew assembleDebug",
    "build": "echo \"static app — nothing to compile\"",
    "test:web": "node --experimental-vm-modules --test tests/",
    "test:backend": "python3 -m unittest discover -s backend -p 'test_*.py' -v"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.4.3",
    "@capacitor/device": "^7.0.1",
    "@capacitor/filesystem": "^7.0.1",
    "@capacitor/geolocation": "^7.1.0",
    "@capacitor/haptics": "^7.0.1",
    "@capacitor/local-notifications": "^7.0.1",
    "@capacitor/network": "^7.0.1",
    "@capacitor/preferences": "^7.0.1",
    "@capacitor/share": "^7.0.1",
    "@capacitor/splash-screen": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}
