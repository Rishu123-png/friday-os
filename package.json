{
  "name": "friday-os",
  "version": "1.0.0",
  "type": "module",
  "description": "FRIDAY OS — personal AI assistant. Offline-first, optional Groq key, offline LLM via llama.cpp.",
  "private": true,
  "scripts": {
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "test": "npm run test:web && npm run test:backend",
    "sync": "npx cap sync android",
    "apk": "cd android && ./gradlew assembleDebug",
    "build": "echo \"static app — nothing to compile\"",
    "test:web": "node --experimental-vm-modules --test tests/",
    "test:backend": "python3 -m unittest discover -s backend -p 'test_*.py' -v"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}
