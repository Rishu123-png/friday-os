<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: exclude encrypted runtime secrets from cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="friday_secure_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="friday_secure_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
