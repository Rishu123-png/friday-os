# FRIDAY OS backend template
# Copy to backend/.env for LOCAL development only. Never commit backend/.env.
# In production, use your host/container secret manager instead of a file.

# Generate a token with: openssl rand -hex 32  (or: python3 -c "import secrets; print(secrets.token_hex(32))")
FRIDAY_TOKEN=
FRIDAY_ALLOW_INSECURE_LOCAL=false

# Provider keys stay on the backend. Rotate any key that has ever been committed.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

BLACKBOX_ENABLED=false
BLACKBOX_API_KEY=
BLACKBOX_MODEL=blackboxai/minimax/minimax-m2.5
BLACKBOX_FREE_MODELS=

# Capacitor uses http://localhost. Add browser/operator origins as comma-separated values.
CORS_ORIGINS=http://localhost,capacitor://localhost
ALLOW_USER_HEADER=false

DB_PATH=./friday.db
ACTION_DB_PATH=./action_queue.db
ACTION_CLAIM_LEASE_SECONDS=90
MAX_AUDIO_BYTES=25000000
TTS_VOICE=en-IN-NeerjaNeural
STT_MODEL=small
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional Telegram bridge. Keep allow-all false; list your numeric user IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=
TELEGRAM_ALLOW_ALL=false

# Optional MQTT bridge.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_PREFIX=friday
