# FRIDAY OS backend — copy to backend/.env and fill in ( NEVER commit .env )

# Groq key for the server brain (get free at console.groq.com)
GROQ_API_KEY=

# Shared secret between your app and server. SET THIS on a public host!
# Put the same value in the app: Settings → FRIDAY Cloud → Server token
FRIDAY_TOKEN=

# Optional overrides
GROQ_MODEL=llama-3.3-70b-versatile
CORS_ORIGINS=*
DB_PATH=./friday.db
TTS_VOICE=en-IN-NeerjaNeural
STT_MODEL=small

# Optional: Telegram bridge (talk to FRIDAY from Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=

# Optional: smart home via MQTT (Home Assistant / ESPHome / Tasmota)
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Optional Blackbox fallback — OFF by default. Public API endpoint is fixed in code
# to the official https://api.blackbox.ai/chat/completions endpoint.
BLACKBOX_ENABLED=false
BLACKBOX_API_KEY=
BLACKBOX_MODEL=blackboxai/minimax/minimax-m2.5
# Safety gate: only set after your Blackbox account confirms this exact model is free.
# Example (operator attestation, not a guarantee from FRIDAY):
BLACKBOX_FREE_MODELS=
